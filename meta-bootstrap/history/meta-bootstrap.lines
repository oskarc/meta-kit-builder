  > .claude/skills/meta-manifest/INSTALLED.sha1
  category: [system type identified in Step 3]
  concern: [from library]
  dependencies: [from library]
  generation_added: [N]
  inherited: true
  inherited_from: [kit_name] v[version] generation [N]
  kit_name: [project name]-kit
  kit_type: type-category
  layer: [from library]
  open_gaps: [from library]
  parent_kit: meta-kit-builder
  phase: [from library]
  skill_file: [from library]
  status: [from library]
  status: active
  version: 0.1
  | sort -z | xargs -0 sha1sum > .claude/skills/meta-manifest/INSTALLED.sha1
  | while IFS= read -r -d '' f; do printf '%s  %s\n' "$(tr -d '\r' < "$f" | sha1sum | cut -c1-40)" "$f"; done \
